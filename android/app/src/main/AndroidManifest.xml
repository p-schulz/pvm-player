<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Media is opened by plain path (file browser, libmpv), which needs
         "all files access". Fine for sideloading; the Play Store restricts it. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- enableOnBackInvokedCallback=false: keep the classic BACK key event, so
         the app (not the system's predictive-back handling) decides what Back
         does on each screen. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="PVM Player"
        android:theme="@style/Theme.PVMPlayer">

        <!-- The launcher entry: no UI, starts MainActivity on the primary
             display (see LaunchActivity). -->
        <activity
            android:name=".LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PVMPlayer.Launch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- configChanges covers everything a controller hot-plug or a
             fold/unfold can toggle, so the Activity (and the GL context tied
             to it) is not recreated. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">

            <meta-data
                android:name="android.app.lib_name"
                android:value="pvm_player" />
        </activity>
    </application>

</manifest>
