// Generated by scripts/setup.sh / setup.ps1 from scripts/templates/vscode/.
{
  // The presets (CMakePresets.json + the generated CMakeUserPresets.json)
  // are the single source of build settings.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

  "files.associations": {
    "*.frag": "glsl",
    "*.vert": "glsl",
    "*.cfg": "properties"
  },
  "files.exclude": {
    "**/.DS_Store": true
  },
  "search.exclude": {
    "build": true,
    "thirdparty": true,
    "android/app/build": true,
    "android/.gradle": true
  }
}
