// Generated by scripts/setup.sh / setup.ps1 from scripts/templates/vscode/.
// Needs the "C/C++" extension (ms-vscode.cpptools). Debugger by OS: lldb on
// macOS, gdb on Linux, the Visual Studio debugger on Windows.
{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "mediaDir",
      "type": "promptString",
      "description": "Media folder for Play Media (blank = current directory)",
      "default": "."
    }
  ],
  "configurations": [
    {
      "name": "PVM Player (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/local-debug/pvm_player",
      "args": ["${input:mediaDir}"],
      "cwd": "${workspaceFolder}/build/local-debug",
      "stopAtEntry": false,
      "preLaunchTask": "Build (Debug)",
      "osx": { "MIMode": "lldb" },
      "linux": {
        "MIMode": "gdb",
        "setupCommands": [
          { "description": "Pretty-print STL", "text": "-enable-pretty-printing", "ignoreFailures": true }
        ]
      },
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}\\build\\local-debug\\pvm_player.exe"
      }
    },
    {
      "name": "PVM Player (Release build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/local-release/pvm_player",
      "args": ["${input:mediaDir}"],
      "cwd": "${workspaceFolder}/build/local-release",
      "stopAtEntry": false,
      "preLaunchTask": "Build (Release)",
      "osx": { "MIMode": "lldb" },
      "linux": { "MIMode": "gdb" },
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}\\build\\local-release\\pvm_player.exe"
      }
    }
  ]
}
